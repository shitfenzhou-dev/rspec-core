+
+  describe ":rerun_argument" do
+    def stub_example(location, id, file_path = "spec/foo_spec.rb", line_number = 1)
+      result = RSpec::Core::Example::ExecutionResult.new
+      result.started_at = ::Time.now
+      result.record_finished(:passed, ::Time.now)
+      instance_double(RSpec::Core::Example,
+        :id => id,
+        :description => "Example",
+        :full_description => "Example",
+        :execution_result => result,
+        :location_rerun_argument => location,
+        :exception => nil,
+        :metadata => {
+          :file_path => file_path,
+          :line_number => line_number,
+          :shared_group_inclusion_backtrace => []
+        }
+      )
+    end
+
+    it "uses location_rerun_argument when locations are unique" do
+      ex1 = stub_example("./spec/foo_spec.rb:1", "./spec/foo_spec.rb[1:1]")
+      ex2 = stub_example("./spec/foo_spec.rb:2", "./spec/foo_spec.rb[1:2]")
+      reporter.examples << ex1 << ex2
+      send_notification :stop, stop_notification
+
+      examples = formatter.output_hash[:examples]
+      expect(examples[0][:rerun_argument]).to eq("./spec/foo_spec.rb:1")
+      expect(examples[1][:rerun_argument]).to eq("./spec/foo_spec.rb:2")
+    end
+
+    it "falls back to example.id when multiple examples share the same location" do
+      ex1 = stub_example("./spec/foo_spec.rb:1", "./spec/foo_spec.rb[1:1]")
+      ex2 = stub_example("./spec/foo_spec.rb:1", "./spec/foo_spec.rb[1:2]")
+      reporter.examples << ex1 << ex2
+      send_notification :stop, stop_notification
+
+      examples = formatter.output_hash[:examples]
+      expect(examples[0][:rerun_argument]).to eq("./spec/foo_spec.rb[1:1]")
+      expect(examples[1][:rerun_argument]).to eq("./spec/foo_spec.rb[1:2]")
+    end
+
+    context "when force_line_number_for_spec_rerun is true" do
+      around do |example|
+        original = RSpec.configuration.force_line_number_for_spec_rerun
+        RSpec.configuration.force_line_number_for_spec_rerun = true
+        example.run
+        RSpec.configuration.force_line_number_for_spec_rerun = original
+      end
+
+      it "uses location_rerun_argument even when locations are duplicate" do
+        ex1 = stub_example("./spec/foo_spec.rb:1", "./spec/foo_spec.rb[1:1]")
+        ex2 = stub_example("./spec/foo_spec.rb:1", "./spec/foo_spec.rb[1:2]")
+        reporter.examples << ex1 << ex2
+        send_notification :stop, stop_notification
+
+        examples = formatter.output_hash[:examples]
+        expect(examples[0][:rerun_argument]).to eq("./spec/foo_spec.rb:1")
+        expect(examples[1][:rerun_argument]).to eq("./spec/foo_spec.rb:1")
+      end
+    end
+
+    it "includes rerun_argument for all examples" do
+      ex1 = stub_example("./spec/foo_spec.rb:1", "./spec/foo_spec.rb[1:1]")
+      ex2 = stub_example("./spec/foo_spec.rb:2", "./spec/foo_spec.rb[1:2]")
+      ex3 = stub_example("./spec/foo_spec.rb:3", "./spec/foo_spec.rb[1:3]")
+      reporter.examples << ex1 << ex2 << ex3
+      send_notification :stop, stop_notification
+
+      examples = formatter.output_hash[:examples]
+      expect(examples.size).to eq(3)
+      expect(examples).to all(have_key(:rerun_argument))
+    end
+
+    it "profile slowest examples use the same rerun_argument rules" do
+      setup_profiler
+      formatter
+
+      ex1 = stub_example("./spec/foo_spec.rb:1", "./spec/foo_spec.rb[1:1]")
+      ex2 = stub_example("./spec/foo_spec.rb:1", "./spec/foo_spec.rb[1:2]")
+      reporter.examples << ex1 << ex2
+      send_notification :stop, stop_notification
+      send_notification :dump_profile, profile_notification(0.5, [ex1, ex2], 10)
+
+      profile_examples = formatter.output_hash[:profile][:examples]
+      expect(profile_examples[0][:rerun_argument]).to eq("./spec/foo_spec.rb[1:1]")
+      expect(profile_examples[1][:rerun_argument]).to eq("./spec/foo_spec.rb[1:2]")
+    end
+
+    context "when dump_profile is called without stop" do
+      it "computes duplicate locations from profile examples and does not raise" do
+        setup_profiler
+        formatter
+
+        ex1 = stub_example("./spec/foo_spec.rb:1", "./spec/foo_spec.rb[1:1]")
+        ex2 = stub_example("./spec/foo_spec.rb:1", "./spec/foo_spec.rb[1:2]")
+
+        expect {
+          send_notification :dump_profile, profile_notification(0.5, [ex1, ex2], 10)
+        }.not_to raise_error
+
+        profile_examples = formatter.output_hash[:profile][:examples]
+        expect(profile_examples[0][:rerun_argument]).to eq("./spec/foo_spec.rb[1:1]")
+        expect(profile_examples[1][:rerun_argument]).to eq("./spec/foo_spec.rb[1:2]")
+      end
+    end
+  end
 end
